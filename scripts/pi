    else
      debug_clean_minutes="$(duration_to_find_minutes "${DEBUG_CLEAN_AGE}")"
      run_ssh_expect_with_sudo "mkdir -p '${PI_DEBUG_RECORDING_DIR}' && echo '== removed debug recordings (older than ${DEBUG_CLEAN_AGE}) ==' && find '${PI_DEBUG_RECORDING_DIR}' -maxdepth 1 -type f -name '*.wav' -mmin +${debug_clean_minutes} -print -delete 2>/dev/null && echo && echo '== remaining debug recordings ==' && find '${PI_DEBUG_RECORDING_DIR}' -maxdepth 1 -type f -name '*.wav' | wc -l && du -sh '${PI_DEBUG_RECORDING_DIR}' 2>/dev/null || true"
    fi
    ;;

  bridge-test)
    bridge_test "$@"
    ;;

  monitor)
    if [[ $# -lt 1 ]]; then
      echo "Usage: ./scripts/pi monitor <on|off|status>" >&2
      exit 1
    fi
    monitor_action="$1"
    monitor_helper="${PI_REMOTE_BRIDGE_DIR}/raspberry_tools/monitor_power.sh"
    case "$monitor_action" in
      on|off|status)
        run_ssh_expect_with_sudo "'${monitor_helper}' '${monitor_action}'"
        ;;
      *)
        echo "Usage: ./scripts/pi monitor <on|off|status>" >&2
        exit 1
        ;;
    esac
    ;;

  lights)
    if [[ $# -lt 2 ]]; then
      echo "Usage: ./scripts/pi lights <room|studio|all> <on|off> [--execute]" >&2
      exit 1
    fi
    target="$1"
    action="$2"
    phrase="$(lights_phrase "$target" "$action")"
    if [[ "${3:-}" == "--execute" ]]; then
      bridge_test "$phrase" --execute
    else
      bridge_test "$phrase"
    fi
    ;;

  room|studio|all)
    if [[ $# -lt 1 ]]; then
      echo "Usage: ./scripts/pi ${subcommand} <on|off> [--execute]" >&2
      exit 1
    fi
    action="$1"
    phrase="$(lights_phrase "$subcommand" "$action")"
    if [[ "${2:-}" == "--execute" ]]; then
      bridge_test "$phrase" --execute
    else
      bridge_test "$phrase"
    fi
    ;;

  deploy)
    need_password
    expect "${PROJECT_DIR}/scripts/deploy_to_pi.expect" \
      "${PI_PASSWORD}" \
      "${PI_HOST}" \
      "${PI_REMOTE_BRIDGE_DIR}" \
      "${PROJECT_DIR}"
    expect "${PROJECT_DIR}/scripts/deploy_voice_services.expect" \
      "${PI_PASSWORD}" \
      "${PI_HOST}" \
      "${PROJECT_DIR}/voice_services" \
      "${PI_REMOTE_BRIDGE_DIR}/voice_services"
    ;;

  deploy-voice)
    need_password
    expect "${PROJECT_DIR}/scripts/deploy_voice_services.expect" \
      "${PI_PASSWORD}" \
      "${PI_HOST}" \
      "${PROJECT_DIR}/voice_services" \
      "${PI_REMOTE_BRIDGE_DIR}/voice_services"
    ;;

  sync-ha)
    need_password
    expect "${PROJECT_DIR}/scripts/sync_ha_bootstrap.expect" \
      "${PI_PASSWORD}" \
      "${PI_HOST}" \
      "${PROJECT_DIR}/homeassistant_bootstrap" \
      "${PI_REMOTE_BOOTSTRAP_DIR}"
    ;;

  redeploy)
    need_password
    "${PROJECT_DIR}/scripts/redeploy_pi_stack.sh" "${PI_PASSWORD}" "${PI_HOST}"
    ;;

  fetch-debug)
    need_password
    expect "${PROJECT_DIR}/scripts/fetch_pi_debug.expect" \
      "${PI_PASSWORD}" \
      "${PI_HOST}" \
      "${PI_REMOTE_BRIDGE_DIR}" \
      "${PROJECT_DIR}/pi_debug"
    ;;

  satellite-fast)
    bridge_env_file="${PI_REMOTE_BRIDGE_DIR}/.env"
    voice_env_file="${PI_REMOTE_BRIDGE_DIR}/voice_services/respeaker_lite_satellite.env"
    voice_services_env_file="${PI_REMOTE_BRIDGE_DIR}/voice_services/.env"
    whisper_model=base-int8
    whisper_beam_size=1
    whisper_cpu_threads=2
    whisper_vad_min_speech_ms=200
    whisper_vad_min_silence_ms=700
    whisper_initial_prompt=""
    run_ssh_expect_with_sudo "if [ -f '${voice_env_file}' ]; then \
      if grep -q '^WAKE_REFRACTORY_SECONDS=' '${voice_env_file}'; then sed -i \"s/^WAKE_REFRACTORY_SECONDS=.*/WAKE_REFRACTORY_SECONDS=8/\" '${voice_env_file}'; else printf '\nWAKE_REFRACTORY_SECONDS=8\n' >> '${voice_env_file}'; fi; \
      if grep -q '^MIC_SECONDS_TO_MUTE_AFTER_AWAKE_WAV=' '${voice_env_file}'; then sed -i \"s/^MIC_SECONDS_TO_MUTE_AFTER_AWAKE_WAV=.*/MIC_SECONDS_TO_MUTE_AFTER_AWAKE_WAV=0.0/\" '${voice_env_file}'; else printf '\nMIC_SECONDS_TO_MUTE_AFTER_AWAKE_WAV=0.0\n' >> '${voice_env_file}'; fi; \
      if grep -q '^SND_VOLUME_MULTIPLIER=' '${voice_env_file}'; then sed -i \"s/^SND_VOLUME_MULTIPLIER=.*/SND_VOLUME_MULTIPLIER=2.5/\" '${voice_env_file}'; else printf '\nSND_VOLUME_MULTIPLIER=2.5\n' >> '${voice_env_file}'; fi; \
      if grep -q '^SND_MIXER_CARD=' '${voice_env_file}'; then sed -i \"s/^SND_MIXER_CARD=.*/SND_MIXER_CARD=Headphones/\" '${voice_env_file}'; else printf '\nSND_MIXER_CARD=Headphones\n' >> '${voice_env_file}'; fi; \
      if grep -q '^SND_MIXER_CONTROL=' '${voice_env_file}'; then sed -i \"s/^SND_MIXER_CONTROL=.*/SND_MIXER_CONTROL=PCM/\" '${voice_env_file}'; else printf '\nSND_MIXER_CONTROL=PCM\n' >> '${voice_env_file}'; fi; \
      if grep -q '^SND_MIXER_LEVEL=' '${voice_env_file}'; then sed -i \"s/^SND_MIXER_LEVEL=.*/SND_MIXER_LEVEL=100%/\" '${voice_env_file}'; else printf '\nSND_MIXER_LEVEL=100%\n' >> '${voice_env_file}'; fi; \
      if grep -q '^SATELLITE_STREAMING_TIMEOUT_SECONDS=' '${voice_env_file}'; then sed -i \"s/^SATELLITE_STREAMING_TIMEOUT_SECONDS=.*/SATELLITE_STREAMING_TIMEOUT_SECONDS=20/\" '${voice_env_file}'; else printf '\nSATELLITE_STREAMING_TIMEOUT_SECONDS=20\n' >> '${voice_env_file}'; fi; \
      if grep -q '^SATELLITE_NO_SPEECH_TIMEOUT_SECONDS=' '${voice_env_file}'; then sed -i \"s/^SATELLITE_NO_SPEECH_TIMEOUT_SECONDS=.*/SATELLITE_NO_SPEECH_TIMEOUT_SECONDS=0/\" '${voice_env_file}'; else printf '\nSATELLITE_NO_SPEECH_TIMEOUT_SECONDS=0\n' >> '${voice_env_file}'; fi; \
      if grep -q '^SATELLITE_TRANSCRIPT_TIMEOUT_SECONDS=' '${voice_env_file}'; then sed -i \"s/^SATELLITE_TRANSCRIPT_TIMEOUT_SECONDS=.*/SATELLITE_TRANSCRIPT_TIMEOUT_SECONDS=0/\" '${voice_env_file}'; else printf '\nSATELLITE_TRANSCRIPT_TIMEOUT_SECONDS=0\n' >> '${voice_env_file}'; fi; \
      if grep -q '^SATELLITE_POST_TRANSCRIPT_COOLDOWN_SECONDS=' '${voice_env_file}'; then sed -i \"s/^SATELLITE_POST_TRANSCRIPT_COOLDOWN_SECONDS=.*/SATELLITE_POST_TRANSCRIPT_COOLDOWN_SECONDS=0/\" '${voice_env_file}'; else printf '\nSATELLITE_POST_TRANSCRIPT_COOLDOWN_SECONDS=0\n' >> '${voice_env_file}'; fi; \
      if grep -q '^SATELLITE_FORCE_ASSIST_IDLE_ON_RECOVERY=' '${voice_env_file}'; then sed -i \"s/^SATELLITE_FORCE_ASSIST_IDLE_ON_RECOVERY=.*/SATELLITE_FORCE_ASSIST_IDLE_ON_RECOVERY=0/\" '${voice_env_file}'; else printf '\nSATELLITE_FORCE_ASSIST_IDLE_ON_RECOVERY=0\n' >> '${voice_env_file}'; fi; \
      if grep -q '^SATELLITE_DEBUG_RECORDING_DIR=' '${voice_env_file}'; then sed -i \"s|^SATELLITE_DEBUG_RECORDING_DIR=.*|SATELLITE_DEBUG_RECORDING_DIR=|\" '${voice_env_file}'; else printf '\nSATELLITE_DEBUG_RECORDING_DIR=\n' >> '${voice_env_file}'; fi; \
      if grep -q '^SATELLITE_DEBUG=' '${voice_env_file}'; then sed -i \"s/^SATELLITE_DEBUG=.*/SATELLITE_DEBUG=0/\" '${voice_env_file}'; else printf '\nSATELLITE_DEBUG=0\n' >> '${voice_env_file}'; fi; \
      if [ -f '${bridge_env_file}' ]; then \
        if grep -q '^ASSIST_GUARD_RECENT_WAKE_WINDOW_SECONDS=' '${bridge_env_file}'; then sed -i \"s/^ASSIST_GUARD_RECENT_WAKE_WINDOW_SECONDS=.*/ASSIST_GUARD_RECENT_WAKE_WINDOW_SECONDS=45/\" '${bridge_env_file}'; else printf '\nASSIST_GUARD_RECENT_WAKE_WINDOW_SECONDS=45\n' >> '${bridge_env_file}'; fi; \
      fi; \
      if [ -f '${voice_services_env_file}' ]; then \
        if grep -q '^WAKE_WORD_REFRACTORY_SECONDS=' '${voice_services_env_file}'; then sed -i \"s/^WAKE_WORD_REFRACTORY_SECONDS=.*/WAKE_WORD_REFRACTORY_SECONDS=8.0/\" '${voice_services_env_file}'; else printf '\nWAKE_WORD_REFRACTORY_SECONDS=8.0\n' >> '${voice_services_env_file}'; fi; \
        if grep -q '^WHISPER_MODEL=' '${voice_services_env_file}'; then sed -i \"s/^WHISPER_MODEL=.*/WHISPER_MODEL=${whisper_model}/\" '${voice_services_env_file}'; else printf '\nWHISPER_MODEL=${whisper_model}\n' >> '${voice_services_env_file}'; fi; \
        if grep -q '^WHISPER_BEAM_SIZE=' '${voice_services_env_file}'; then sed -i \"s/^WHISPER_BEAM_SIZE=.*/WHISPER_BEAM_SIZE=${whisper_beam_size}/\" '${voice_services_env_file}'; else printf '\nWHISPER_BEAM_SIZE=${whisper_beam_size}\n' >> '${voice_services_env_file}'; fi; \
        if grep -q '^WHISPER_CPU_THREADS=' '${voice_services_env_file}'; then sed -i \"s/^WHISPER_CPU_THREADS=.*/WHISPER_CPU_THREADS=${whisper_cpu_threads}/\" '${voice_services_env_file}'; else printf '\nWHISPER_CPU_THREADS=${whisper_cpu_threads}\n' >> '${voice_services_env_file}'; fi; \
        if grep -q '^WHISPER_VAD_MIN_SPEECH_MS=' '${voice_services_env_file}'; then sed -i \"s/^WHISPER_VAD_MIN_SPEECH_MS=.*/WHISPER_VAD_MIN_SPEECH_MS=${whisper_vad_min_speech_ms}/\" '${voice_services_env_file}'; else printf '\nWHISPER_VAD_MIN_SPEECH_MS=${whisper_vad_min_speech_ms}\n' >> '${voice_services_env_file}'; fi; \
        if grep -q '^WHISPER_VAD_MIN_SILENCE_MS=' '${voice_services_env_file}'; then sed -i \"s/^WHISPER_VAD_MIN_SILENCE_MS=.*/WHISPER_VAD_MIN_SILENCE_MS=${whisper_vad_min_silence_ms}/\" '${voice_services_env_file}'; else printf '\nWHISPER_VAD_MIN_SILENCE_MS=${whisper_vad_min_silence_ms}\n' >> '${voice_services_env_file}'; fi; \
        if grep -q '^WHISPER_INITIAL_PROMPT=' '${voice_services_env_file}'; then sed -i \"s|^WHISPER_INITIAL_PROMPT=.*|WHISPER_INITIAL_PROMPT=${whisper_initial_prompt}|\" '${voice_services_env_file}'; else printf '\nWHISPER_INITIAL_PROMPT=${whisper_initial_prompt}\n' >> '${voice_services_env_file}'; fi; \
      fi; \
      cd '${PI_REMOTE_BRIDGE_DIR}/voice_services' && ./configure_voice_services_env.sh && (docker compose stop whisper >/dev/null 2>&1 || true) && (docker compose rm -f whisper >/dev/null 2>&1 || true) && docker compose up -d speech-to-phrase; \
      systemctl restart wyoming-satellite.service; \
      grep -E '^(WAKE_REFRACTORY_SECONDS|MIC_SECONDS_TO_MUTE_AFTER_AWAKE_WAV|SND_VOLUME_MULTIPLIER|SND_MIXER_CARD|SND_MIXER_CONTROL|SND_MIXER_LEVEL|SATELLITE_STREAMING_TIMEOUT_SECONDS|SATELLITE_NO_SPEECH_TIMEOUT_SECONDS|SATELLITE_TRANSCRIPT_TIMEOUT_SECONDS|SATELLITE_POST_TRANSCRIPT_COOLDOWN_SECONDS|SATELLITE_FORCE_ASSIST_IDLE_ON_RECOVERY|SATELLITE_DEBUG_RECORDING_DIR|SATELLITE_DEBUG)=' '${voice_env_file}'; \
      echo; grep -E '^(STT_ENGINE|SPEECH_TO_PHRASE_HASS_WEBSOCKET_URI|SPEECH_TO_PHRASE_CUSTOM_SENTENCES_DIR|WHISPER_MODEL|WHISPER_BEAM_SIZE|WHISPER_CPU_THREADS|WHISPER_VAD_MIN_SPEECH_MS|WHISPER_VAD_MIN_SILENCE_MS)=' '${voice_services_env_file}' 2>/dev/null || true; \
      echo; systemctl status wyoming-satellite.service --no-pager; \
    else \
      echo 'Missing voice env file:' '${voice_env_file}' >&2; exit 1; \
    fi"
    ;;

  ssh)
    exec ssh -o StrictHostKeyChecking=accept-new "${PI_USER}@${PI_HOST}"
    ;;

  *)
    echo "Unknown subcommand: ${subcommand}" >&2
    echo >&2
    show_help
    exit 1
    ;;
esac
