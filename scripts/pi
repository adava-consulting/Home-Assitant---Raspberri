#!/usr/bin/env bash
set -euo pipefail

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CONFIG_FILE="${PI_CONFIG_FILE:-${PROJECT_DIR}/.pi.env}"

if [[ -f "$CONFIG_FILE" ]]; then
  # shellcheck disable=SC1090
  source "$CONFIG_FILE"
fi

: "${PI_HOST:=192.168.0.17}"
: "${PI_USER:=lucas}"
: "${PI_PASSWORD:=}"
: "${PI_REMOTE_BRIDGE_DIR:=/home/lucas/ha-command-bridge}"
: "${PI_REMOTE_BRIDGE_DATA_DIR:=/home/lucas/ha-command-bridge-data}"
: "${PI_REMOTE_BOOTSTRAP_DIR:=/home/lucas/homeassistant-bootstrap}"
: "${PI_LOG_SINCE_DEFAULT:=30m}"
: "${PI_DEBUG_RECORDING_DIR:=/tmp/wyoming-debug}"
: "${PI_DEBUG_RECORDING_CLEAN_DEFAULT:=24h}"

escape_single_quotes() {
  printf "%s" "$1" | sed "s/'/'\"'\"'/g"
}

need_password() {
  if [[ -z "${PI_PASSWORD}" ]]; then
    echo "PI_PASSWORD is empty. Create ${CONFIG_FILE} from .pi.env.example." >&2
    exit 1
  fi
}

run_ssh_expect() {
  need_password
  expect "${PROJECT_DIR}/scripts/ssh_command.expect" \
    "${PI_PASSWORD}" \
    "${PI_HOST}" \
    "$1"
}

run_ssh_expect_with_sudo() {
  need_password
  local escaped_password
  escaped_password="$(escape_single_quotes "${PI_PASSWORD}")"
  local command="$1"
  run_ssh_expect "printf '%s\n' '${escaped_password}' | sudo -S -p '' bash -lc '$(escape_single_quotes "$command")'"
}

validate_duration_token() {
  local value="$1"
  if ! [[ "$value" =~ ^[0-9]+[smhd]$ ]]; then
    echo "Unsupported duration '${value}'. Use values like 30m, 2h, or 1d." >&2
    exit 1
  fi
}

journal_since_expr() {
  local value="$1"
  if [[ "$value" =~ ^([0-9]+)([smhd])$ ]]; then
    local amount="${BASH_REMATCH[1]}"
    local unit="${BASH_REMATCH[2]}"
    case "$unit" in
      s) printf '%s seconds ago' "$amount" ;;
      m) printf '%s minutes ago' "$amount" ;;
      h) printf '%s hours ago' "$amount" ;;
      d) printf '%s days ago' "$amount" ;;
    esac
    return 0
  fi

  printf '%s' "$value"
}

duration_to_find_minutes() {
  local value="$1"
  if ! [[ "$value" =~ ^([0-9]+)([smhd])$ ]]; then
    echo "Unsupported duration '${value}'. Use values like 30m, 2h, or 1d." >&2
    exit 1
  fi

  local amount="${BASH_REMATCH[1]}"
  local unit="${BASH_REMATCH[2]}"
  local minutes=0
  case "$unit" in
    s) minutes=$(( (amount + 59) / 60 )) ;;
    m) minutes=$amount ;;
    h) minutes=$(( amount * 60 )) ;;
    d) minutes=$(( amount * 1440 )) ;;
  esac

  if (( minutes < 1 )); then
    minutes=1
  fi

  printf '%s' "$minutes"
}

duration_to_seconds() {
  local value="$1"
  if ! [[ "$value" =~ ^([0-9]+)([smhd])$ ]]; then
    echo "Unsupported duration '${value}'. Use values like 30m, 2h, or 1d." >&2
    exit 1
  fi

  local amount="${BASH_REMATCH[1]}"
  local unit="${BASH_REMATCH[2]}"
  case "$unit" in
    s) printf '%s' "$amount" ;;
    m) printf '%s' "$(( amount * 60 ))" ;;
    h) printf '%s' "$(( amount * 3600 ))" ;;
    d) printf '%s' "$(( amount * 86400 ))" ;;
  esac
}

parse_recent_window_args() {
  RECENT_WINDOW_MODE="since"
  RECENT_WINDOW_SINCE="$PI_LOG_SINCE_DEFAULT"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --all)
        RECENT_WINDOW_MODE="all"
        shift
        ;;
      --since)
        if [[ $# -lt 2 ]]; then
          echo "Missing value for --since" >&2
          exit 1
        fi
        validate_duration_token "$2"
        RECENT_WINDOW_SINCE="$2"
        RECENT_WINDOW_MODE="since"
        shift 2
        ;;
      --since=*)
        local since_value="${1#--since=}"
        validate_duration_token "$since_value"
        RECENT_WINDOW_SINCE="$since_value"
        RECENT_WINDOW_MODE="since"
        shift
        ;;
      --since[0-9]*[smhd])
        local since_value="${1#--since}"
        validate_duration_token "$since_value"
        RECENT_WINDOW_SINCE="$since_value"
        RECENT_WINDOW_MODE="since"
        shift
        ;;
      *)
        echo "Unexpected argument: $1" >&2
        exit 1
        ;;
    esac
  done
}

recent_window_description() {
  if [[ "${RECENT_WINDOW_MODE}" == "all" ]]; then
    printf 'all available history'
    return 0
  fi

  printf 'last %s' "${RECENT_WINDOW_SINCE}"
}

docker_logs_recent_command() {
  local container="$1"
  local tail_count="$2"
  local command="docker logs --tail ${tail_count}"
  if [[ "${RECENT_WINDOW_MODE}" == "since" ]]; then
    command+=" --since ${RECENT_WINDOW_SINCE}"
  fi
  command+=" ${container}"
  printf '%s' "$command"
}

journalctl_recent_command() {
  local unit="$1"
  local tail_count="$2"
  if [[ "${RECENT_WINDOW_MODE}" == "since" ]]; then
    local journal_since
    journal_since="$(journal_since_expr "${RECENT_WINDOW_SINCE}")"
    printf 'journalctl -u %s --since "%s" -n %s --no-pager' "$unit" "$journal_since" "$tail_count"
    return 0
  fi

  printf 'journalctl -u %s -n %s --no-pager' "$unit" "$tail_count"
}

wake_debug_summary() {
  local recent_window_desc="$1"
  local journal_cmd
  local openwakeword_logs_cmd
  local speech_to_phrase_logs_cmd
  local whisper_logs_cmd
  local recent_window_seconds="all"
  local summary_cmd

  journal_cmd="$(journalctl_recent_command 'wyoming-satellite.service' 200)"
  openwakeword_logs_cmd="$(docker_logs_recent_command 'wyoming-openwakeword' 120)"
  speech_to_phrase_logs_cmd="$(docker_logs_recent_command 'wyoming-speech-to-phrase' 120)"
  whisper_logs_cmd="$(docker_logs_recent_command 'wyoming-whisper' 120)"
  if [[ "${RECENT_WINDOW_MODE}" == "since" ]]; then
    recent_window_seconds="$(duration_to_seconds "${RECENT_WINDOW_SINCE}")"
  fi

  summary_cmd="$(cat <<EOF
tmp_dir=\$(mktemp -d)
cleanup() { rm -rf "\$tmp_dir"; }
trap cleanup EXIT
date -Iseconds >"\$tmp_dir/pi_now.txt" 2>&1 || true
date -u -Iseconds >"\$tmp_dir/pi_now_utc.txt" 2>&1 || true
timedatectl show -p Timezone --value >"\$tmp_dir/pi_timezone.txt" 2>&1 || true
${journal_cmd} >"\$tmp_dir/satellite.log" 2>&1 || true
${openwakeword_logs_cmd} >"\$tmp_dir/openwakeword.log" 2>&1 || true
${speech_to_phrase_logs_cmd} >"\$tmp_dir/speech-to-phrase.log" 2>&1 || true
${whisper_logs_cmd} >"\$tmp_dir/whisper.log" 2>&1 || true
curl -fsS 'http://127.0.0.1:8000/activity?limit=40' >"\$tmp_dir/activity.json" 2>/dev/null || printf '%s\n' '{"count":0,"entries":[]}' >"\$tmp_dir/activity.json"
curl -fsS 'http://127.0.0.1:8000/assist-guard' >"\$tmp_dir/assist_guard.json" 2>/dev/null || printf '%s\n' '{"enabled":false,"state":{}}' >"\$tmp_dir/assist_guard.json"
python3 - "\$tmp_dir" "${recent_window_desc}" "${recent_window_seconds}" <<'PY'
from __future__ import annotations

from datetime import datetime, timedelta, timezone
import json
from pathlib import Path
import re
import sys
import time

root = Path(sys.argv[1])
recent_window_desc = sys.argv[2]
recent_window_seconds_arg = sys.argv[3]
recent_window_seconds = None if recent_window_seconds_arg == "all" else int(recent_window_seconds_arg)


def read_text(name: str) -> str:
    path = root / name
    try:
        return path.read_text("utf-8", errors="replace")
    except FileNotFoundError:
        return ""


def read_json(name: str, fallback: dict) -> dict:
    path = root / name
    try:
        payload = json.loads(path.read_text("utf-8", errors="replace"))
    except Exception:
        return dict(fallback)
    return payload if isinstance(payload, dict) else dict(fallback)


def read_one_line(name: str) -> str:
    return " ".join(read_text(name).split())


def count(pattern: str, text: str, *, flags: int = 0) -> int:
    return len(re.findall(pattern, text, flags))


def truncate(value: str, limit: int = 80) -> str:
    compact = " ".join(str(value).split())
    if len(compact) <= limit:
        return compact
    return compact[: limit - 3] + "..."


def age_seconds(timestamp_ms: object, *, now_ms: int) -> str:
    try:
        timestamp_ms = int(timestamp_ms)
    except (TypeError, ValueError):
        return "none"
    if timestamp_ms <= 0:
        return "none"
    age_ms = max(0, now_ms - timestamp_ms)
    return f"{age_ms / 1000:.1f}"


def parse_occurred_at(value: object) -> datetime | None:
    if value in (None, ""):
        return None

    try:
        return datetime.fromisoformat(str(value).replace("Z", "+00:00"))
    except ValueError:
        return None


satellite_log = read_text("satellite.log")
openwakeword_log = read_text("openwakeword.log")
speech_to_phrase_log = read_text("speech-to-phrase.log")
whisper_log = read_text("whisper.log")
combined_logs = "\n".join([satellite_log, openwakeword_log, speech_to_phrase_log, whisper_log])

activity_payload = read_json("activity.json", {"count": 0, "entries": []})
assist_guard_payload = read_json("assist_guard.json", {"enabled": False, "state": {}})

activity_entries = activity_payload.get("entries")
if not isinstance(activity_entries, list):
    activity_entries = []

if recent_window_seconds is not None:
    cutoff = datetime.now(timezone.utc) - timedelta(seconds=recent_window_seconds)
    filtered_entries = []
    for entry in activity_entries:
        if not isinstance(entry, dict):
            continue
        occurred_at = parse_occurred_at(entry.get("occurred_at"))
        if occurred_at is None or occurred_at >= cutoff:
            filtered_entries.append(entry)
    activity_entries = filtered_entries

assist_entries = [
    entry
    for entry in activity_entries
    if isinstance(entry, dict) and str(entry.get("source", "")).startswith("assist_")
]
assist_failed_entries = [entry for entry in assist_entries if entry.get("status") == "failed"]
guard_failures = [
    entry
    for entry in assist_failed_entries
    if isinstance(entry.get("details"), dict) and entry["details"].get("guard") == "assist_recent_wake"
]
last_assist_entry = assist_entries[0] if assist_entries else None
last_assist_error = None
if assist_failed_entries:
    details = assist_failed_entries[0].get("details")
    if isinstance(details, dict):
        last_assist_error = details.get("error")

assist_guard_state = assist_guard_payload.get("state")
if not isinstance(assist_guard_state, dict):
    assist_guard_state = {}

now_ms = int(time.time() * 1000)
detections = count(r"Detection\(", satellite_log)
transcripts = count(r"Event\(type=.transcript", satellite_log)
syntheses = count(r"Event\(type=.synthesize", satellite_log)
satellite_errors = count(r"Event\(type=.error", satellite_log)
no_speech_restarts = count(r"No speech detected", satellite_log)
transcript_timeouts = count(r"Transcript not received", satellite_log)
stt_no_text = count(r"stt-no-text-recognized", combined_logs)
wake_beeps = count(r"Playing raw data", satellite_log)
whisper_empty_transcripts = count(
    r"INFO:wyoming_faster_whisper\.dispatch_handler:\s*$",
    whisper_log,
    flags=re.MULTILINE,
)
whisper_suspicious_transcripts = count(r"Sanitized suspicious transcript", whisper_log)
whisper_delivery_failures = count(r"Transcript delivery failed because the client disconnected", whisper_log)
speech_to_phrase_training = count(r"training|retrain", speech_to_phrase_log, flags=re.IGNORECASE)
speech_to_phrase_errors = count(r"error|traceback|failed", speech_to_phrase_log, flags=re.IGNORECASE)
bridge_assist_entries = len(assist_entries)
bridge_assist_executed = sum(1 for entry in assist_entries if entry.get("status") == "executed")
bridge_assist_failed = len(assist_failed_entries)
assist_guard_failures = len(guard_failures)

print(f"== wake-debug summary ({recent_window_desc}) ==")
print(
    "time:"
    f" pi_now={read_one_line('pi_now.txt') or 'unknown'}"
    f" pi_timezone={read_one_line('pi_timezone.txt') or 'unknown'}"
    f" pi_now_utc={read_one_line('pi_now_utc.txt') or 'unknown'}"
)
print(
    "wake_counts:"
    f" detections={detections}"
    f" wake_beeps={wake_beeps}"
    f" transcripts={transcripts}"
    f" synthesize={syntheses}"
    f" satellite_errors={satellite_errors}"
)
print(
    "recovery_counts:"
    f" no_speech_restarts={no_speech_restarts}"
    f" transcript_timeouts={transcript_timeouts}"
    f" stt_no_text={stt_no_text}"
    f" whisper_empty={whisper_empty_transcripts}"
    f" whisper_suspicious={whisper_suspicious_transcripts}"
    f" whisper_delivery_failed={whisper_delivery_failures}"
    f" speech_to_phrase_training={speech_to_phrase_training}"
    f" speech_to_phrase_errors={speech_to_phrase_errors}"
)
print(
    "bridge_counts:"
    f" assist_entries={bridge_assist_entries}"
    f" assist_executed={bridge_assist_executed}"
    f" assist_failed={bridge_assist_failed}"
    f" assist_guard_failures={assist_guard_failures}"
)
print(
    "assist_guard:"
    f" enabled={bool(assist_guard_payload.get('enabled'))}"
    f" last_detection_age_s={age_seconds(assist_guard_state.get('last_detection_ms'), now_ms=now_ms)}"
    f" last_consumed_age_s={age_seconds(assist_guard_state.get('last_consumed_detection_ms'), now_ms=now_ms)}"
)

if last_assist_entry is not None:
    print(
        "last_assist:"
        f" status={last_assist_entry.get('status', 'unknown')}"
        f" source={last_assist_entry.get('source', 'unknown')}"
        f" text={truncate(last_assist_entry.get('text', ''))!r}"
    )
if last_assist_error:
    print(f"last_assist_error: {truncate(last_assist_error, limit=140)}")

print()
print("Likely breakpoint:")
if detections == 0:
    if wake_beeps > 0:
        print(
            "- Wake debug detection lines were not logged, but wake beep playback was observed. "
            "This usually means satellite debug logging is off; treat the beep count as wake evidence."
        )
    else:
        print(
            "- No wake detections were observed in the selected window. "
            "If the failed attempt is inside this window, focus on openWakeWord sensitivity or the mic path."
        )
elif transcripts == 0:
    if speech_to_phrase_errors > 0:
        print(
            "- Speech-to-Phrase logged errors. Check Home Assistant token/websocket access "
            "or custom sentence training before tuning wake/audio."
        )
    elif whisper_delivery_failures > 0:
        print(
            "- Whisper produced or attempted to deliver a transcript, but the satellite client "
            "disconnected first. Focus on satellite restarts/watchdog timing or Pi throttling."
        )
    elif whisper_empty_transcripts > 0:
        print(
            "- Wake was detected, and Whisper returned an empty transcript. "
            "That is expected for wake-only tests and should not execute a command."
        )
    elif whisper_suspicious_transcripts > 0:
        print(
            "- Wake was detected, but Whisper produced a suspicious non-command transcript. "
            "The bridge/guard rejected it instead of executing a device action."
        )
    elif no_speech_restarts > 0:
        print(
            "- Wake was detected, but the satellite restarted for no-speech before any transcript arrived. "
            "This points to the wake-to-stream handoff or the command start being missed."
        )
    elif stt_no_text > 0:
        print(
            "- Wake appears to have reached STT, but Whisper returned no usable text."
        )
    else:
        print(
            "- Wake was detected, but no transcript reached the bridge. "
            "Check the satellite and Whisper handoff."
        )
elif bridge_assist_entries == 0:
    print(
        "- Transcripts were observed, but no recent Assist activity reached the bridge. "
        "Check the Home Assistant Assist pipeline routing."
    )
elif bridge_assist_executed > 0:
    print(
        "- The selected window includes at least one successful end-to-end Assist execution."
    )
elif assist_guard_failures > 0:
    print(
        "- Assist reached the bridge, but the recent command was rejected by the recent-wake guard."
    )
elif bridge_assist_failed > 0:
    print(
        "- Assist reached the bridge, but the recent command failed before execution."
    )
else:
    print(
        "- The raw logs do not point to one obvious breakpoint yet. Check the detailed sections below."
    )
PY
EOF
)"

  run_ssh_expect_with_sudo "$summary_cmd"
}

latency_check_summary() {
  local recent_window_desc="$1"
  local journal_cmd
  local recent_window_seconds="all"
  local summary_cmd

  journal_cmd="$(journalctl_recent_command 'wyoming-satellite.service' 240)"
  if [[ "${RECENT_WINDOW_MODE}" == "since" ]]; then
    recent_window_seconds="$(duration_to_seconds "${RECENT_WINDOW_SINCE}")"
  fi

  summary_cmd="$(cat <<EOF
tmp_dir=\$(mktemp -d)
cleanup() { rm -rf "\$tmp_dir"; }
trap cleanup EXIT
date -Iseconds >"\$tmp_dir/pi_now.txt" 2>&1 || true
timedatectl show -p Timezone --value >"\$tmp_dir/pi_timezone.txt" 2>&1 || true
${journal_cmd} >"\$tmp_dir/satellite.log" 2>&1 || true
curl -fsS 'http://127.0.0.1:8000/activity?limit=80' >"\$tmp_dir/activity.json" 2>/dev/null || printf '%s\n' '{"count":0,"entries":[]}' >"\$tmp_dir/activity.json"
python3 - "\$tmp_dir" "${recent_window_desc}" "${recent_window_seconds}" <<'PY'
from __future__ import annotations

import ast
from datetime import UTC, datetime, timedelta
import json
from pathlib import Path
import re
import sys
from zoneinfo import ZoneInfo

root = Path(sys.argv[1])
recent_window_desc = sys.argv[2]
recent_window_seconds_arg = sys.argv[3]
recent_window_seconds = None if recent_window_seconds_arg == "all" else int(recent_window_seconds_arg)


def read_text(name: str) -> str:
    path = root / name
    try:
        return path.read_text("utf-8", errors="replace")
    except FileNotFoundError:
        return ""


def read_json(name: str, fallback: dict) -> dict:
    path = root / name
    try:
        payload = json.loads(path.read_text("utf-8", errors="replace"))
    except Exception:
        return dict(fallback)
    return payload if isinstance(payload, dict) else dict(fallback)


def read_one_line(name: str) -> str:
    return " ".join(read_text(name).split())


def parse_occurred_at(value: object) -> datetime | None:
    if value in (None, ""):
        return None
    try:
        return datetime.fromisoformat(str(value).replace("Z", "+00:00"))
    except ValueError:
        return None


def normalize_text(value: object) -> str:
    compact = re.sub(r"[^a-z0-9]+", " ", str(value or "").lower())
    return " ".join(compact.split())


def format_ms(value: object) -> str:
    if value in (None, ""):
        return "none"
    try:
        return str(int(round(float(value))))
    except (TypeError, ValueError):
        return "none"


def stats(values: list[int]) -> str:
    if not values:
        return "count=0"
    ordered = sorted(values)
    middle = len(ordered) // 2
    median = ordered[middle] if len(ordered) % 2 == 1 else round((ordered[middle - 1] + ordered[middle]) / 2)
    return f"count={len(ordered)} min={ordered[0]} median={median} max={ordered[-1]}"


def truncate(value: object, limit: int = 72) -> str:
    compact = " ".join(str(value or "").split())
    if len(compact) <= limit:
        return compact
    return compact[: limit - 3] + "..."


def detail_value(details: dict[str, object], key: str, limit: int = 96) -> str:
    value = details.get(key)
    if value in (None, ""):
        return "none"
    return truncate(value, limit=limit)


def parse_journal_timestamp(raw_value: str, *, year: int, tz_name: str) -> datetime | None:
    try:
        parsed = datetime.strptime(f"{year} {raw_value}", "%Y %b %d %H:%M:%S")
        return parsed.replace(tzinfo=journal_tz)
    except Exception:
        return None


satellite_log = read_text("satellite.log")
activity_payload = read_json("activity.json", {"count": 0, "entries": []})
activity_entries = activity_payload.get("entries")
if not isinstance(activity_entries, list):
    activity_entries = []

pi_now = parse_occurred_at(read_one_line("pi_now.txt"))
tz_name = read_one_line("pi_timezone.txt") or "UTC"
try:
    journal_tz = ZoneInfo(tz_name)
except Exception:
    journal_tz = UTC
current_year = (pi_now or datetime.now(UTC)).astimezone(journal_tz).year
cutoff = None
if recent_window_seconds is not None:
    cutoff = (pi_now or datetime.now(UTC)) - timedelta(seconds=recent_window_seconds)

detections: list[dict[str, object]] = []
transcripts: list[dict[str, object]] = []
detection_re = re.compile(r"^(?P<ts>[A-Z][a-z]{2}\s+\d+\s+\d{2}:\d{2}:\d{2}).*Detection\(")
transcript_re = re.compile(
    r"^(?P<ts>[A-Z][a-z]{2}\s+\d+\s+\d{2}:\d{2}:\d{2}).*Event\(type='transcript', data=\{'text': (?P<text>.+?)\}, payload=None\)"
)

for line in satellite_log.splitlines():
    detection_match = detection_re.search(line)
    if detection_match:
        detected_at = parse_journal_timestamp(
            detection_match.group("ts"),
            year=current_year,
            tz_name=tz_name,
        )
        if detected_at is not None and (cutoff is None or detected_at >= cutoff):
            detections.append({"at": detected_at, "matched": False})
        continue

    transcript_match = transcript_re.search(line)
    if transcript_match:
        transcript_at = parse_journal_timestamp(
            transcript_match.group("ts"),
            year=current_year,
            tz_name=tz_name,
        )
        if transcript_at is None or (cutoff is not None and transcript_at < cutoff):
            continue
        try:
            transcript_text = ast.literal_eval(transcript_match.group("text"))
        except Exception:
            transcript_text = transcript_match.group("text")
        transcripts.append(
            {
                "at": transcript_at,
                "text": str(transcript_text),
                "norm": normalize_text(transcript_text),
                "matched": False,
            }
        )

assist_entries: list[dict[str, object]] = []
for entry in activity_entries:
    if not isinstance(entry, dict):
        continue
    if not str(entry.get("source", "")).startswith("assist_"):
        continue
    occurred_at = parse_occurred_at(entry.get("occurred_at"))
    if cutoff is not None and occurred_at is not None and occurred_at < cutoff:
        continue
    assist_entries.append(entry)

assist_entries.sort(key=lambda entry: parse_occurred_at(entry.get("occurred_at")) or datetime.min.replace(tzinfo=UTC))


def mark_detection_match(detection_at: datetime | None) -> None:
    if detection_at is None:
        return
    for detection in detections:
        if detection["matched"]:
            continue
        if abs((detection["at"] - detection_at).total_seconds()) <= 2:
            detection["matched"] = True
            return


def match_transcript(entry_text: str, occurred_at: datetime | None, detection_at: datetime | None) -> dict[str, object] | None:
    normalized = normalize_text(entry_text)
    if not normalized or occurred_at is None:
        return None

    for transcript in transcripts:
        if transcript["matched"] or transcript["norm"] != normalized:
            continue
        transcript_at = transcript["at"]
        if detection_at is not None and transcript_at < detection_at - timedelta(seconds=2):
            continue
        if transcript_at > occurred_at + timedelta(seconds=2):
            continue
        if (occurred_at - transcript_at).total_seconds() > 90:
            continue
        transcript["matched"] = True
        return transcript
    return None


executed_count = sum(1 for entry in assist_entries if entry.get("status") == "executed")
failed_count = sum(1 for entry in assist_entries if entry.get("status") == "failed")
wake_to_result_values: list[int] = []
bridge_total_values: list[int] = []
plan_apply_values: list[int] = []
attempt_lines: list[str] = []

for entry in assist_entries[-8:]:
    occurred_at = parse_occurred_at(entry.get("occurred_at"))
    details = entry.get("details")
    if not isinstance(details, dict):
        details = {}

    detection_at = parse_occurred_at(details.get("assist_guard_detection_at"))
    transcript = match_transcript(str(entry.get("text", "")), occurred_at, detection_at)
    transcript_at = transcript.get("at") if transcript is not None else None
    mark_detection_match(detection_at)

    bridge_total_ms = details.get("bridge_total_ms")
    plan_apply_ms = details.get("plan_apply_ms")
    wake_to_bridge_ms = details.get("assist_guard_detection_age_ms")

    wake_to_result_ms = None
    if detection_at is not None and occurred_at is not None:
        wake_to_result_ms = round((occurred_at - detection_at).total_seconds() * 1000)
    elif bridge_total_ms not in (None, "") and wake_to_bridge_ms not in (None, ""):
        try:
            wake_to_result_ms = int(round(float(bridge_total_ms) + float(wake_to_bridge_ms)))
        except (TypeError, ValueError):
            wake_to_result_ms = None

    if bridge_total_ms not in (None, ""):
        try:
            bridge_total_values.append(int(round(float(bridge_total_ms))))
        except (TypeError, ValueError):
            pass
    if plan_apply_ms not in (None, ""):
        try:
            plan_apply_values.append(int(round(float(plan_apply_ms))))
        except (TypeError, ValueError):
            pass
    if wake_to_result_ms is not None:
        wake_to_result_values.append(int(wake_to_result_ms))

    wake_to_transcript_ms = None
    transcript_to_result_ms = None
    if detection_at is not None and transcript_at is not None:
        wake_to_transcript_ms = round((transcript_at - detection_at).total_seconds() * 1000)
    if transcript_at is not None and occurred_at is not None:
        transcript_to_result_ms = round((occurred_at - transcript_at).total_seconds() * 1000)

    detail_parts = [
        f"source={truncate(entry.get('source', ''), limit=48)!r}",
        f"guard={detail_value(details, 'guard', limit=48)!r}",
        f"error={detail_value(details, 'error', limit=120)!r}",
    ]
    attempt_lines.append(
        "\n".join(
            [
                f"{(occurred_at.isoformat() if occurred_at is not None else 'unknown')} status={entry.get('status', 'unknown')} text={truncate(entry.get('text', ''))!r}",
                "  " + " ".join(detail_parts),
                "  "
                + " ".join(
                    [
                        f"wake_to_bridge_ms={format_ms(wake_to_bridge_ms)}",
                        f"wake_to_transcript_ms={format_ms(wake_to_transcript_ms)}",
                        f"transcript_to_result_ms={format_ms(transcript_to_result_ms)}",
                        f"wake_to_result_ms={format_ms(wake_to_result_ms)}",
                        f"bridge_total_ms={format_ms(bridge_total_ms)}",
                        f"state_fetch_ms={format_ms(details.get('state_fetch_ms'))}",
                        f"interpret_ms={format_ms(details.get('interpret_ms'))}",
                        f"plan_apply_ms={format_ms(plan_apply_ms)}",
                    ]
                ),
            ]
        )
    )

unmatched_detections = sum(1 for detection in detections if not detection["matched"])
unmatched_transcripts = sum(1 for transcript in transcripts if not transcript["matched"])

print(f"== latency-check summary ({recent_window_desc}) ==")
print(
    "events:"
    f" detections={len(detections)}"
    f" transcripts={len(transcripts)}"
    f" assist_entries={len(assist_entries)}"
    f" executed={executed_count}"
    f" failed={failed_count}"
    f" unmatched_detections={unmatched_detections}"
    f" unmatched_transcripts={unmatched_transcripts}"
)
print(f"wake_to_result_ms: {stats(wake_to_result_values)}")
print(f"bridge_total_ms: {stats(bridge_total_values)}")
print(f"plan_apply_ms: {stats(plan_apply_values)}")

print()
print("== recent assist attempts ==")
if attempt_lines:
    for line in attempt_lines:
        print(line)
else:
    print("No recent assist activity entries were found in the selected window.")
PY
EOF
)"

  run_ssh_expect_with_sudo "$summary_cmd"
}

parse_debug_clean_args() {
  DEBUG_CLEAN_MODE="older-than"
  DEBUG_CLEAN_AGE="$PI_DEBUG_RECORDING_CLEAN_DEFAULT"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --all)
        DEBUG_CLEAN_MODE="all"
        shift
        ;;
      --older-than)
        if [[ $# -lt 2 ]]; then
          echo "Missing value for --older-than" >&2
          exit 1
        fi
        validate_duration_token "$2"
        DEBUG_CLEAN_AGE="$2"
        DEBUG_CLEAN_MODE="older-than"
        shift 2
        ;;
      *)
        echo "Unexpected argument: $1" >&2
        exit 1
        ;;
    esac
  done
}

