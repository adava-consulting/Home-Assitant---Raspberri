# Copy this file to `.env` in the same directory if you want to override
# the default voice service settings.

# openWakeWord
WAKE_WORD_MODEL=hey_jarvis
WAKE_WORD_THRESHOLD=0.18
WAKE_WORD_TRIGGER_LEVEL=1
# Keep wake detection quiet through the end of the current command to avoid
# immediate post-transcript self-triggers.
WAKE_WORD_REFRACTORY_SECONDS=8.0

# Primary STT: Speech-to-Phrase
#
# This is intentionally the default for this command-focused setup. It answers
# "which known phrase did the user say?" instead of doing open-ended dictation,
# which avoids Whisper-style hallucinations like invented commands.
STT_ENGINE=speech_to_phrase
SPEECH_TO_PHRASE_HASS_WEBSOCKET_URI=ws://host.docker.internal:8123/api/websocket
# Filled automatically from the bridge .env by configure_voice_services_env.sh
# during deploy. Keep this blank in examples and commits.
SPEECH_TO_PHRASE_HASS_TOKEN=
SPEECH_TO_PHRASE_CUSTOM_SENTENCES_DIR=/home/lucas/homeassistant-bootstrap/custom_sentences

# Whisper / faster-whisper fallback
#
# Whisper is still available with `docker compose --profile whisper up -d whisper`
# and is exposed on host port 10301. The normal Assist pipeline should use
# Speech-to-Phrase on port 10300.
WHISPER_MODEL=base-int8
WHISPER_LANGUAGE=en
# Smaller beam sizes decode faster on CPU. `1` is a good low-latency default
# for short home automation commands.
WHISPER_BEAM_SIZE=1
# Keep two cores free-ish for Home Assistant, Docker, and thermal headroom.
WHISPER_CPU_THREADS=2
# Keep empty by default. Command examples leaked into transcripts on short or
# poor audio turns and could look like commands the user never said.
WHISPER_INITIAL_PROMPT=
# Keep short commands responsive without making the segmenter too eager.
WHISPER_VAD_MIN_SPEECH_MS=200
WHISPER_VAD_MIN_SILENCE_MS=700

# Piper
PIPER_VOICE=en_US-lessac-medium
